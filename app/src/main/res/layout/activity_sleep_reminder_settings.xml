<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/sleepReminderSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_reminder_settings_title"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:paddingBottom="16dp" />

        <EditText
            android:id="@+id/sleepReminderTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sleep_reminder_text_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:maxLines="4"
            android:gravity="top|start"
            android:padding="12dp" />

        <Button
            android:id="@+id/updateSleepReminderTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_reminder_update_text_button"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/startTimeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sleep_reminder_start_button" />

            <Space
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/endTimeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sleep_reminder_end_button" />
        </LinearLayout>

        <TextView
            android:id="@+id/sizeHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_reminder_window_size_header"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/widthValueLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="12dp"
            tools:text="Width: 60%" />

        <SeekBar
            android:id="@+id/widthSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="20"
            android:progress="60" />

        <TextView
            android:id="@+id/heightValueLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="16dp"
            tools:text="Height: 20%" />

        <SeekBar
            android:id="@+id/heightSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="20"
            android:progress="20" />

        <Button
            android:id="@+id/saveSleepReminderButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_reminder_save_button"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/showSleepReminderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_reminder_show_button" />

            <Space
                android:layout_width="24dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/hideSleepReminderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_reminder_hide_button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
